<% posted_count = Enum.count(@activity, &(&1.status == "posted")) %>

<h1 class="view-title">
  Good morning, {@current_scope.user.display_name || "there"} <span class="accent">—</span> the books are quiet today.
</h1>
<p class="view-sub">
  May 2026 · everything reconciled through May 8
  · {@in_flight_count} document{if @in_flight_count == 1, do: "", else: "s"} in flight
</p>

{live_render(@conn, ZaimuTomoWeb.ProcessingHeroLive, id: "processing-hero")}

<div class="grid grid-12">
  <div class="span-12">
    <div class="grid grid-12">
      <div class="card span-12">
        <div class="card-head" style="margin-bottom:6px">
          <div class="label">Net worth</div>
          <div class="card-meta">Latest account balances, grouped by source currency</div>
        </div>
        <div :if={@net_worth_by_currency == []} class="empty-state" id="dashboard-net-worth-empty">
          <div class="h">No account balances yet</div>
          <div class="muted">Add an account and its balance to see net worth.</div>
        </div>
        <div :for={total <- @net_worth_by_currency} class="hero-num" id={"dashboard-net-worth-#{total.currency}"}>
          <span>{fmt_cents(total.total_cents, total.currency)}</span>
          <span class="cents"> · {total.account_count} account{if total.account_count == 1, do: "", else: "s"}</span>
        </div>
        <div class="hero-row">
          <div class="hero-stat">
            <div class="label">Cash</div>
            <div :if={@cash_accounts == []} class="v">—</div>
            <div :if={@cash_accounts == []} class="delta muted">Add a cash account</div>
            <div :for={%{account: account, balance_snapshot: snapshot} <- @cash_accounts} id={"dashboard-cash-#{account.id}"}>
              <div class="v">{if snapshot, do: fmt_cents(snapshot.amount_cents, account.currency), else: "—"}</div>
              <div class="delta muted">{account.name}{if snapshot, do: " · #{snapshot.recorded_on}", else: " · no balance"}</div>
            </div>
            <.link navigate={~p"/accounts"} class="delta up">Manage accounts</.link>
          </div>
          <div class="hero-stat">
            <div class="label">Investments</div>
            <div :if={@investment_accounts == []} class="v">—</div>
            <div :if={@investment_accounts == []} class="delta muted">Add an investment account</div>
            <div :for={%{account: account, balance_snapshot: snapshot} <- @investment_accounts} id={"dashboard-investments-#{account.id}"}>
              <div class="v">{if snapshot, do: fmt_cents(snapshot.amount_cents, account.currency), else: "—"}</div>
              <div class="delta muted">{account.name}{if snapshot, do: " · #{snapshot.recorded_on}", else: " · no balance"}</div>
            </div>
            <.link navigate={~p"/accounts"} class="delta up">Manage accounts</.link>
          </div>
          <div class="hero-stat">
            <div class="label">Savings</div>
            <div :if={@savings_accounts == []} class="v">—</div>
            <div :if={@savings_accounts == []} class="delta muted">Add a savings account</div>
            <div :for={%{account: account, balance_snapshot: snapshot} <- @savings_accounts} id={"dashboard-savings-#{account.id}"}>
              <div class="v">{if snapshot, do: fmt_cents(snapshot.amount_cents, account.currency), else: "—"}</div>
              <div class="delta muted">{account.name}{if snapshot, do: " · #{snapshot.recorded_on}", else: " · no balance"}</div>
            </div>
            <.link navigate={~p"/accounts"} class="delta up">Manage accounts</.link>
          </div>
          <div class="hero-stat">
            <div class="label">Projected EoM</div>
            <div class="v">{fmt(@summary.projection_eom)}</div>
            <div class="delta up">on track</div>
          </div>
        </div>
      </div>

      <%!-- ── Current month spending ── --%>
      <div class="card span-7">
        <div class="spending-period-summary">
          <div>
            <div class="label">{@spending_month} spending</div>
            <div class="spending-period-amount tnum mono">
              {fmt_cents(@spending.total_cents, @spending.currency)}
            </div>
          </div>
          <div class="spending-period-comparison">
            <div class="label">Compared with {@previous_spending_month}</div>
            <div class="spending-period-amount tnum mono dim">
              {fmt_cents(@previous_spending.total_cents, @previous_spending.currency)}
            </div>
          </div>
        </div>
        <div class={"budget-bar #{@month_comparison_class}"} style="margin-bottom:14px">
          <div class="fill" style={"width:#{Float.round(@month_pct, 1)}%"}></div>
        </div>
        <div :if={@spending_categories == []} id="spending-empty" class="empty-state">
          <div class="h">No categorized spending yet</div>
          <div class="muted">Posted journal entries for this month will appear here.</div>
        </div>
        <div :if={@spending_categories != []} id="spending-categories" style="margin-top:6px">
          <div class="budget-row spending-row spending-row-labels" aria-hidden="true">
            <div class="name">Category</div>
            <div class="num">{@spending_month}</div>
            <div class="num">{@previous_spending_month}</div>
            <div class="num">Change</div>
          </div>
          <%= for cat <- @spending_categories do %>
            <div
              class="budget-row spending-row"
              data-category={cat.category}
              data-total-cents={cat.total_cents}
              data-previous-total-cents={cat.previous_total_cents}
              data-delta-cents={cat.delta_cents}
            >
              <div class="name">
                <span class="cat-dot" style={"background:#{cat.color}"}></span>
                {cat.category}
              </div>
              <div class="num">{fmt_cents(cat.total_cents, @spending.currency)}</div>
              <div class="num dim">
                {fmt_cents(cat.previous_total_cents, @previous_spending.currency)}
              </div>
              <div class={["num", cat.delta_cents > 0 && "over", cat.delta_cents <= 0 && "dim"]}>
                {fmt_cents_delta(cat.delta_cents)}
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%!-- ── Where it goes (donut) ── --%>
      <div class="card span-5">
        <div class="card-head">
          <div class="card-title">Where it goes</div>
          <div class="card-meta">{@spending_month}, by category</div>
        </div>
        <div :if={@spending_categories == []} id="spending-chart-empty" class="empty-state">
          <div class="h">Nothing to chart</div>
          <div class="muted">Categorize and post an entry to see the breakdown.</div>
        </div>
        <div
          :if={@spending_categories != [] and @spending.total_cents <= 0}
          id="spending-chart-zero-total"
          class="empty-state"
        >
          <div class="h">Nothing to chart</div>
          <div class="muted">Categorized entries net to zero or a credit this month.</div>
        </div>
        <div
          :if={@spending_categories != [] and @spending.total_cents > 0}
          id="spending-chart"
          class="donut-wrap"
        >
          <div class="donut">
            <.donut_chart segments={@donut_segments} size={160} />
            <div class="donut-center">
              <div>
                <div class="v">{fmt_cents(@spending.total_cents, @spending.currency)}</div>
                <div class="l">this month</div>
              </div>
            </div>
          </div>
          <div class="cat-list">
            <%= for cat <- @spending_categories do %>
              <div class="cat-list-row" data-category={cat.category}>
                <div class="left">
                  <span class="cat-dot" style={"background:#{cat.color}"}></span>
                  <span>{cat.category}</span>
                  <span class="pct">
                    {trunc(cat.total_cents / @spending.total_cents * 100)}%
                  </span>
                </div>
                <div></div>
                <div class="amt">{fmt_cents(cat.total_cents, @spending.currency)}</div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%!-- ── Quick add / drop zone ── --%>
      <div class="card span-5">
        <div class="card-head" style="margin-bottom:8px">
          <div class="card-title">Quick add</div>
          <div class="card-meta">drop · paste · click</div>
        </div>
        {live_render(@conn, ZaimuTomoWeb.DocumentUploadLive, id: "doc-upload")}
        <div
          style="display:flex;justify-content:space-between;margin-top:14px;font-size:11.5px"
          class="muted"
        >
          <span>This month: <span class="mono dim">{posted_count}</span> documents posted</span>
          <span class="mono">avg ~3.1s OCR</span>
        </div>
      </div>

      <%!-- ── Upcoming this month ── --%>
      <div class="card span-7">
        <div class="card-head">
          <div class="card-title">Upcoming this month</div>
          <div class="card-meta mono dim">
            {fmt(Enum.sum(Enum.map(@upcoming, & &1.amt)))} planned
          </div>
        </div>
        <%= for u <- @upcoming do %>
          <div class="upcoming-row">
            <div class="date-chip">
              <div class="d">{u.d}</div>
              <div class="m">{u.m}</div>
            </div>
            <div>
              <div class="name">{u.name}</div>
              <div class="sub">{u.sub}</div>
            </div>
            <div class="amt">{fmt(u.amt)}</div>
          </div>
        <% end %>
      </div>

      <%!-- ── Recent activity ── --%>
      <div class="card span-12">
        <div class="card-head">
          <div class="card-title">Recent activity</div>
          <div class="card-meta">
            <a class="muted" href={~p"/documents"} style="cursor:pointer">View all →</a>
          </div>
        </div>
        <div class="feed">
          <%= for item <- Enum.take(@activity, 5) do %>
            <.feed_item item={item} categories={@categories} />
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
