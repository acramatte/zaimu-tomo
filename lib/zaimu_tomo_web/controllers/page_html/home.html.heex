<%
  nw = @summary.net_worth
  nw_whole = nw |> trunc() |> abs()
  nw_cents = round((nw - trunc(nw)) * 100) |> abs()
  nw_sign  = if nw < 0, do: "−", else: ""
  nw_w =
    nw_whole
    |> Integer.to_string()
    |> String.graphemes()
    |> Enum.reverse()
    |> Enum.chunk_every(3)
    |> Enum.join(",")
    |> String.reverse()
  nw_c = String.pad_leading(Integer.to_string(nw_cents), 2, "0")
  posted_count = Enum.count(@activity, &(&1.status == "posted"))
%>

<h1 class="view-title">
  Good morning, Sora <span class="accent">—</span> the books are quiet today.
</h1>
<p class="view-sub">
  May 2026 · everything reconciled through May 8
  · {@in_flight_count} document{if @in_flight_count == 1, do: "", else: "s"} in flight
</p>

<div class="grid grid-12">
  <div class="span-12">
    <div class="grid grid-12">

      <div class="card span-12">
        <div class="card-head" style="margin-bottom:6px">
          <div class="label">Net worth</div>
          <div class="card-meta">
            <span class="dim mono">+ {fmt(@summary.net_worth - List.first(@networth_history))}</span>
            <span class="muted"> over 6 months</span>
          </div>
        </div>
        <div class="hero-num">
          <span class="cur">€{nw_sign}</span>
          <span>{nw_w}</span>
          <span class="cents">.{nw_c}</span>
        </div>
        <div style="margin-top:10px">
          <.sparkline values={@networth_history} w={800} h={56} />
        </div>
        <div class="hero-row">
          <div class="hero-stat">
            <div class="label">Cash</div>
            <div class="v">{fmt(@summary.cash)}</div>
            <div class="delta up">▲ €82.41 wk</div>
          </div>
          <div class="hero-stat">
            <div class="label">Investments</div>
            <div class="v">{fmt(@summary.investments)}</div>
            <div class="delta up">▲ 1.2% wk</div>
          </div>
          <div class="hero-stat">
            <div class="label">Savings</div>
            <div class="v">{fmt(@summary.savings)}</div>
            <div class="delta up">▲ €100 wk</div>
          </div>
          <div class="hero-stat">
            <div class="label">Projected EoM</div>
            <div class="v">{fmt(@summary.projection_eom)}</div>
            <div class="delta up">on track</div>
          </div>
        </div>
      </div>

      <%!-- ── May spending vs budget ── --%>
      <div class="card span-7">
        <div class="card-head">
          <div class="card-title">May spending</div>
          <div class="card-meta tnum mono">
            <span class="dim">{fmt(@summary.month_expenses)}</span>
            <span class="muted"> / {fmt(@summary.month_budget)}</span>
          </div>
        </div>
        <div class={"budget-bar #{@budget_class}"} style="margin-bottom:14px">
          <div class="fill" style={"width:#{Float.round(@month_pct, 1)}%"}></div>
        </div>
        <div style="margin-top:6px">
          <%= for cat <- Enum.take(@cats_for_display, 6) do %>
            <%
              over = cat.spent > cat.budget
              diff = cat.spent - cat.budget
            %>
            <div class="budget-row">
              <div class="name">
                <span class="cat-dot" style={"background:#{cat.color}"}></span>
                {cat.name}
              </div>
              <div class={"num #{if over, do: "over", else: ""}"}>{fmt(cat.spent)}</div>
              <div class="num dim">{fmt(cat.budget)}</div>
              <div class={"num #{if over, do: "over", else: "dim"}"}>
                {fmt_num(diff)}
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%!-- ── Where it goes (donut) ── --%>
      <div class="card span-5">
        <div class="card-head">
          <div class="card-title">Where it goes</div>
          <div class="card-meta">May, by category</div>
        </div>
        <div class="donut-wrap">
          <div class="donut">
            <.donut_chart segments={@donut_segments} size={160} />
            <div class="donut-center">
              <div>
                <div class="v">{fmt(@total_spent) |> String.trim_leading("€")}</div>
                <div class="l">€ this month</div>
              </div>
            </div>
          </div>
          <div class="cat-list">
            <%= for cat <- Enum.take(@cats_for_display, 6) do %>
              <div class="cat-list-row">
                <div class="left">
                  <span class="cat-dot" style={"background:#{cat.color}"}></span>
                  <span>{cat.name}</span>
                  <span class="pct">{trunc(cat.spent / @total_spent * 100)}%</span>
                </div>
                <div></div>
                <div class="amt">{fmt(cat.spent)}</div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%!-- ── Quick add / drop zone ── --%>
      <div class="card span-5">
        <div class="card-head" style="margin-bottom:8px">
          <div class="card-title">Quick add</div>
          <div class="card-meta">drop · paste · click</div>
        </div>
        <div class="drop-zone" id="drop-zone">
          <div class="glyph">+</div>
          <div class="h">Drop an invoice or receipt</div>
          <div class="sub">PDF, JPG, HEIC · sent to OCR · review takes <span class="kbd">~30s</span></div>
          <div class="sub" style="margin-top:10px">
            or paste with <span class="kbd">⌘V</span>
            · click to <span class="kbd">browse</span>
          </div>
        </div>
        <div style="display:flex;justify-content:space-between;margin-top:14px;font-size:11.5px" class="muted">
          <span>This month: <span class="mono dim">{posted_count}</span> documents posted</span>
          <span class="mono">avg ~3.1s OCR</span>
        </div>
      </div>

      <%!-- ── Upcoming this month ── --%>
      <div class="card span-7">
        <div class="card-head">
          <div class="card-title">Upcoming this month</div>
          <div class="card-meta mono dim">
            {fmt(Enum.sum(Enum.map(@upcoming, & &1.amt)))} planned
          </div>
        </div>
        <%= for u <- @upcoming do %>
          <div class="upcoming-row">
            <div class="date-chip">
              <div class="d">{u.d}</div>
              <div class="m">{u.m}</div>
            </div>
            <div>
              <div class="name">{u.name}</div>
              <div class="sub">{u.sub}</div>
            </div>
            <div class="amt">{fmt(u.amt)}</div>
          </div>
        <% end %>
      </div>

      <%!-- ── Recent activity ── --%>
      <div class="card span-12">
        <div class="card-head">
          <div class="card-title">Recent activity</div>
          <div class="card-meta">
            <a class="muted" href={~p"/documents"} style="cursor:pointer">View all →</a>
          </div>
        </div>
        <div class="feed">
          <%= for item <- Enum.take(@activity, 5) do %>
            <.feed_item item={item} categories={@categories} />
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
