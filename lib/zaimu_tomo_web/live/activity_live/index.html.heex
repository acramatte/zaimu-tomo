<h1 class="view-title">
  Activity <span class="accent">·</span> async processing feed
</h1>
<p class="view-sub">
  Every uploaded document, every OCR job, every posted journal entry — chronological, live over websocket.
</p>

<nav class="tab-row" id="activity-tabs" aria-label="Filter activity">
  <.link
    :for={{key, label, _statuses} <- @tabs}
    patch={tab_path(key)}
    class={["tab", @tab == key && "active"]}
    aria-current={if @tab == key, do: "page"}
  >
    {label} <span class="count">{@counts[key]}</span>
  </.link>
</nav>

<div class="card">
  <div :if={@activity_items == []} id="activity-empty" class="empty-state">
    <div class="h">No activity yet</div>
    <div class="muted">
      <.link navigate={~p"/documents/new"}>Upload a receipt or invoice</.link>
      to start your activity feed.
    </div>
  </div>
  <div :if={@activity_items != [] and @items == []} id="activity-tab-empty" class="empty-state">
    <div class="h">Nothing here right now</div>
    <div class="muted">No documents are in this state.</div>
  </div>
  <div :if={@items != []} id="activity-feed" class="feed">
    <.feed_item :for={item <- @items} item={item} />
  </div>
</div>
