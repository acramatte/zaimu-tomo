<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Zaimutomo">
      {assigns[:page_title]}
    </.live_title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="density-comfortable">
    <div class="app">
      <!-- ========================
           SIDEBAR
           ======================== -->
      <aside class="sidebar" phx-hook=".NavActive" id="sidebar">
        <div class="brand">
          <div class="brand-mark">Z</div>
          <div class="brand-name">
            Zaimutomo
            <small>Personal books</small>
          </div>
        </div>

        <div class="nav-section">Workspace</div>
        <.nav_item navigate={~p"/"} current_path={@current_path}>
          <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="2" width="5" height="6" rx="1" /><rect x="9" y="2" width="5" height="4" rx="1" />
            <rect x="2" y="10" width="5" height="4" rx="1" /><rect x="9" y="8" width="5" height="6" rx="1" />
          </svg>
          Dashboard
        </.nav_item>
        <.nav_item navigate={~p"/accounts"} current_path={@current_path}>
          <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M2 13h12M4 13V7M7 13V4M10 13V9M13 13V6" />
          </svg>
          Accounts
        </.nav_item>
        <.nav_item navigate={~p"/activity"} current_path={@current_path}>
          <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M2 8h2.5l1.5-4 3 8 1.5-4H14" />
          </svg>
          Activity
          <span class="badge" id="nav-activity-badge" style={if assigns[:in_flight_count] == 0, do: "display:none", else: ""}>
            {assigns[:in_flight_count] || 0}
          </span>
        </.nav_item>
        <.nav_item navigate={~p"/journal_entries"} current_path={@current_path}>
          <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 2h8a2 2 0 0 1 2 2v10H5a2 2 0 0 1-2-2V2z" />
            <path d="M6 5h5M6 8h5M6 11h3" />
          </svg>
          Journal entries
        </.nav_item>
        <.nav_item navigate={~p"/tax_claims"} current_path={@current_path}>
          <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 2h8a2 2 0 0 1 2 2v10H5a2 2 0 0 1-2-2V2z" />
            <path d="M6 5h5M6 8h5M6 11h3" />
            <path d="M10 11l1 1 2-2" />
          </svg>
          Tax claims
        </.nav_item>
        <.nav_item navigate={~p"/documents"} current_path={@current_path}>
          <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 2h5l3 3v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z" />
            <path d="M9 2v3h3" />
          </svg>
          Documents
        </.nav_item>
        <.nav_item navigate={~p"/reviews"} current_path={@current_path}>
          <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="8" cy="8" r="6" /><path d="M5 8l2 2 4-4" />
          </svg>
          Reviews
        </.nav_item>
        <.nav_item current_path={@current_path}>
          <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M2 13h12M4 13V7M7 13V4M10 13V9M13 13V6" />
          </svg>
          Budgets
        </.nav_item>

        <div class="nav-section">Settings</div>
        <.nav_item navigate={~p"/users/settings"} current_path={@current_path}>
          <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="8" cy="6" r="3" /><path d="M2.5 14a5.5 5.5 0 0 1 11 0" />
          </svg>
          Settings
        </.nav_item>
        <.nav_item current_path={@current_path}>
          <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="5" cy="5" r="2" /><path d="M7 5h7M2 11h7" /><circle cx="11" cy="11" r="2" />
          </svg>
          Rules &amp; categories
        </.nav_item>

          <%= if @current_scope do %>
        <div class="user-card">
          <div class="avatar">
            {String.slice(@current_scope.user.email, 0, 2) |> String.upcase()}
          </div>
          <div style="min-width:0;flex:1">
            <div class="name">{@current_scope.user.display_name || @current_scope.user.email}</div>
            <div class="meta">{@current_scope.user.base_currency}</div>
          </div>
            <form action={~p"/users/log-out"} method="post" style="display:contents">
              <input type="hidden" name="_method" value="delete" />
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <button type="submit" class="icon-btn" title="Sign out">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M6 3H3a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h3M10 11l3-3-3-3M13 8H6" />
                </svg>
              </button>
            </form>
        </div>
          <% end %>
      </aside>

      <!-- ========================
           MAIN
           ======================== -->
      <main class="main">
        <div class="topbar">
          <div class="crumb">
            <strong id="route-name">{assigns[:page_title] || "Dashboard"}</strong>
            <span class="muted" id="route-sub">· May 2026</span>
          </div>
          <div class="spacer"></div>
          <button class="btn sm" id="quick-add">
            <svg class="ico" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M7 2v10M2 7h10" />
            </svg>
            New expense
          </button>
          <div class="bell" id="bell" title="Notifications">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 7a4 4 0 0 1 8 0v3l1 2H3l1-2V7z" />
              <path d="M6.5 13a1.5 1.5 0 0 0 3 0" />
            </svg>
            <div class="dot"></div>
            <div
              class="count"
              id="bell-count"
              data-server-count={assigns[:in_flight_count] || 0}
            >
              {if (assigns[:in_flight_count] || 0) > 0, do: assigns[:in_flight_count], else: ""}
            </div>
          </div>
        </div>

        <!-- Notification dropdown -->
        <div class="notif-pop" id="notif-pop">
          <header>
            <span>Activity</span>
            <span class="muted" style="font-size:11px;font-family:'Geist Mono',monospace">live · ws connected</span>
          </header>
          <div class="feed" id="notif-feed">
            <%= for item <- Enum.take(assigns[:activity] || [], 6) do %>
              <.notif_feed_item item={item} />
            <% end %>
          </div>
        </div>

        <!-- View -->
        <div class="view" id="view">
          {@inner_content}
        </div>
      </main>
    </div>

    <!-- Global drag overlay -->
    <div class="drop-overlay" id="drop-overlay">
      <div class="msg">drop to scan</div>
    </div>

    <!-- Review modal (Step 2 of 3) -->
    <div class="modal-bg" id="review-modal">
      <div class="modal">
        <header>
          <h3>Review extracted data</h3>
          <span class="muted" style="font-size:12px">Step 2 of 3 · Human-in-the-loop</span>
          <span class="pill review"><span class="pulse"></span>Awaiting review</span>
        </header>
        <div class="modal-body" id="review-body"></div>
        <footer>
          <button class="btn ghost" id="review-cancel">Cancel</button>
          <span class="muted" style="font-size:12px;margin-left:6px">Edits will retrain your extractor</span>
          <div class="spacer"></div>
          <button class="btn" id="review-reject">Reject document</button>
          <button class="btn primary" id="review-approve">Approve &amp; categorize</button>
        </footer>
      </div>
    </div>

    <!-- Category modal (Step 3 of 3) -->
    <div class="modal-bg" id="cat-modal">
      <div class="modal" style="max-width:680px;grid-template-rows:auto auto auto">
        <header>
          <h3>Pick a category</h3>
          <span class="muted" style="font-size:12px">Step 3 of 3</span>
          <span class="pill posted" id="cat-amount-pill"></span>
        </header>
        <div style="padding:24px">
          <div class="label" style="margin-bottom:6px">Suggested by your rules</div>
          <div class="cat-grid" id="cat-suggested"></div>
          <div class="label" style="margin:18px 0 6px">All categories</div>
          <div class="cat-grid" id="cat-all"></div>
        </div>
        <footer>
          <button class="btn ghost" id="cat-back">Back to review</button>
          <div class="spacer"></div>
          <span class="muted" style="font-size:12px" id="cat-selected-label">Pick one to post the journal entry</span>
          <button class="btn primary" id="cat-confirm" disabled>Post entry</button>
        </footer>
      </div>
    </div>

    <!-- Tweaks panel -->
    <div class="tweaks-panel" id="tweaks-panel">
      <header>
        <span>Tweaks</span>
        <span class="x" id="tweaks-close" title="Close">×</span>
      </header>
      <div class="tweaks-section">
        <span class="label">Density</span>
        <div class="seg cols-2" data-tweak="density">
          <button data-val="comfortable" class="active">Comfortable</button>
          <button data-val="compact">Compact</button>
        </div>
      </div>
      <div class="tweaks-section">
        <span class="label">OCR async treatment</span>
        <div class="seg cols-3" data-tweak="async">
          <button data-val="subtle" class="active">Subtle</button>
          <button data-val="inbox">Inbox</button>
          <button data-val="hero">Hero</button>
        </div>
        <div class="tweak-help" id="async-help">Toast + bell badge when documents finish processing.</div>
      </div>
    </div>

    <!-- Toasts -->
    <div class="toast-container" id="toasts"></div>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".NavActive">
      export default {
        mounted() {
          this.updateActive()
          this._onNavigate = () => this.updateActive()
          window.addEventListener("phx:navigate", this._onNavigate)
        },
        destroyed() {
          window.removeEventListener("phx:navigate", this._onNavigate)
        },
        updateActive() {
          const path = window.location.pathname
          this.el.querySelectorAll(".nav-item[href]").forEach(el => {
            const href = el.getAttribute("href")
            el.classList.toggle("active", href === path || (href !== "/" && path.startsWith(href)))
          })
        }
      }
    </script>
  </body>
</html>
