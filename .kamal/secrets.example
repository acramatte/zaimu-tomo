# Copy to .kamal/secrets and fill values, or export these variables before running Kamal.
# Do not commit .kamal/secrets.

KAMAL_SSH_HOST=$KAMAL_SSH_HOST
KAMAL_SSH_USER=$KAMAL_SSH_USER
KAMAL_PROXY_BIND_IP=$KAMAL_PROXY_BIND_IP
PHX_HOST=$PHX_HOST
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SECRET_KEY_BASE=$SECRET_KEY_BASE
MISTRAL_API_KEY=$MISTRAL_API_KEY
# The initial RustFS credential is deliberately shared with the app's generic
# S3 credential. Use the same value for both until per-application credentials
# are introduced.
RUSTFS_SECRET_KEY=$RUSTFS_SECRET_KEY
S3_SECRET_ACCESS_KEY=$S3_SECRET_ACCESS_KEY
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
NOUSRESEARCH_API_KEY=$NOUSRESEARCH_API_KEY

# If using the Kamal-managed Postgres accessory from config/deploy.yml:
# postgresql://zaimu_tomo:<POSTGRES_PASSWORD>@zaimu-tomo-db:5432/zaimu_tomo_prod
# Replace the password explicitly or source it from your password manager.
DATABASE_URL=$DATABASE_URL
LANGFUSE_PUBLIC_KEY=$LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=$LANGFUSE_SECRET_KEY
LANGFUSE_BASE_URL=$LANGFUSE_BASE_URL
